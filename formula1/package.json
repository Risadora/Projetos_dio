{
  "name": "formula-one-api",
  "version": "1.0.0",
  "description": "API de Fórmula 1 com Fastify",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsup src --out-dir dist",
    "start:prod": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "keywords": ["fastify", "api", "formula1", "typescript"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.26.2"
  }
}
